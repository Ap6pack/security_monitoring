# Security Scanner Configuration
# Copy this file to .env and update with your values

# Database
DATABASE_PATH=data/security_scanner.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/security_scanner.log
LOG_FORMAT=json  # json or console

# DNS Configuration
# Note: List values must use JSON format in .env files
DNS_NAMESERVERS=["8.8.8.8", "1.1.1.1"]
DNS_TIMEOUT=5
DNS_MAX_RETRIES=3

# HTTP Client
HTTP_TIMEOUT=10
HTTP_MAX_RETRIES=3
HTTP_MAX_CONNECTIONS=100
HTTP_USER_AGENT=SecurityScanner/0.1.0

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=2
RATE_LIMIT_BURST=5

# Scanner Configuration
MAX_CONCURRENT_SCANS=50
# Note: List values must use JSON format in .env files
SUBDOMAIN_SOURCES=["crtsh", "subfinder", "assetfinder"]
ENABLE_CERTIFICATE_MONITORING=true

# Certificate Data (optional - fallback for rate limiting)
# If crt.sh API is rate limiting, you can manually download the JSON from your browser:
# Visit: https://crt.sh/json?q=example.com
# Save as: data/crtsh_example.com.json
# Then set: CERTIFICATE_JSON_FILE=data/crtsh_example.com.json
CERTIFICATE_JSON_FILE=

# External Tools (optional)
SUBFINDER_PATH=/usr/local/bin/subfinder
ASSETFINDER_PATH=/usr/local/bin/assetfinder

# Email Alerting (optional)
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=security@example.com
SMTP_TO=admin@example.com
SMTP_USE_TLS=true

# Slack Alerting (optional)
ENABLE_SLACK_ALERTS=false
SLACK_WEBHOOK_URL=

# Alert Thresholds
ALERT_ON_CRITICAL=true
ALERT_ON_HIGH=true
ALERT_MIN_FINDINGS=1

# Report Configuration
REPORT_OUTPUT_DIR=reports
# Note: List values must use JSON format in .env files
REPORT_FORMATS=["json", "html", "markdown"]

# Performance Tuning
CACHE_TTL=3600
CACHE_MAX_SIZE=10000
ENABLE_CACHE=true

# Development
DEBUG=false
PROFILE=false
